# === tempmail-vps config ===
APP_NAME=tempmail-vps
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO

# sqlite local hai; prod me bhi theek hai (single container)
DATABASE_URL=sqlite:///./app.db

# tumhara mail domain (Cloudflare Email Routing isi pe hoga)
MAIL_DOMAIN=mail.yourdomain.com

# inbox kitne ghante baad expire ho
MAIL_TTL_HOURS=24

# cleanup loop interval (seconds)
CLEANUP_INTERVAL_SECONDS=300

# /mail/ingest/* protect karne ke liye — Cloudflare worker me same value daalo
INGEST_KEY=change-me-to-long-random
